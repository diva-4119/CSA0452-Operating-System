#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <dirent.h>

int main() {
    int fd;
    char data[20];

    fd = open("test.txt", O_CREAT | O_RDWR, 0644);

    write(fd, "Hello OS", 8);

    lseek(fd, 0, SEEK_SET);

    read(fd, data, 8);
    data[8] = '\0';

    printf("File Content: %s\n", data);

    struct stat s;
    stat("test.txt", &s);

    printf("File Size: %ld bytes\n", s.st_size);

    DIR *d;
    struct dirent *dir;

    d = opendir(".");

    printf("\nFiles in Directory:\n");

    while((dir = readdir(d)) != NULL) {
        printf("%s\n", dir->d_name);
    }

    closedir(d);
    close(fd);

    return 0;
}
