#include <stdio.h>
#include <pthread.h>
#include <semaphore.h>

sem_t wrt;
int data = 0;

void* reader(void* r) {
    printf("Reader reads %d\n", data);
}

void* writer(void* w) {
    sem_wait(&wrt);
    data++;
    printf("Writer writes %d\n", data);
    sem_post(&wrt);
}

int main() {
    pthread_t r,w;
    sem_init(&wrt,0,1);

    pthread_create(&w,NULL,writer,NULL);
    pthread_create(&r,NULL,reader,NULL);

    pthread_join(w,NULL);
    pthread_join(r,NULL);
}
output:
Writer writes 1
Reader reads 1
