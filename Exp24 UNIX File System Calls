#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main() {
    int fd;
    char data[] = "Hello OS";

    fd = open("file.txt", O_CREAT | O_WRONLY, 0644);
    write(fd, data, sizeof(data));
    close(fd);

    printf("File written successfully\n");
    return 0;
}
