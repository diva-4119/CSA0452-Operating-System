#include <stdio.h>

int main() {
    int n, m, i, j, k;
    printf("Enter number of processes: ");
    scanf("%d", &n);
    printf("Enter number of resources: ");
    scanf("%d", &m);

    int alloc[n][m], max[n][m], need[n][m], avail[m], finish[n], safe[n];

    printf("Enter Allocation matrix:\n");
    for(i=0;i<n;i++)
        for(j=0;j<m;j++)
            scanf("%d",&alloc[i][j]);

    printf("Enter Max matrix:\n");
    for(i=0;i<n;i++)
        for(j=0;j<m;j++)
            scanf("%d",&max[i][j]);

    printf("Enter Available resources:\n");
    for(j=0;j<m;j++)
        scanf("%d",&avail[j]);

    for(i=0;i<n;i++)
        for(j=0;j<m;j++)
            need[i][j] = max[i][j] - alloc[i][j];

    for(i=0;i<n;i++) finish[i]=0;

    int count=0;
    while(count<n) {
        for(i=0;i<n;i++) {
            if(!finish[i]) {
                int flag=1;
                for(j=0;j<m;j++)
                    if(need[i][j] > avail[j]) flag=0;

                if(flag) {
                    safe[count++] = i;
                    for(k=0;k<m;k++)
                        avail[k] += alloc[i][k];
                    finish[i]=1;
                }
            }
        }
    }

    printf("Safe Sequence: ");
    for(i=0;i<n;i++)
        printf("P%d ", safe[i]);

    return 0;
}
